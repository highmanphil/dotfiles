#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  kubectl secret NAME [kubectl get flags]

Fetch one Secret and print an editable manifest. Values from data are decoded
into stringData, and server-managed metadata is removed.

Examples:
  kubectl secret my-secret
  kubectl secret my-secret -n my-namespace > my-secret.yaml
  k secret my-secret --context my-cluster
EOF
}

# kubectl delegates completion for external plugins through this command.
# Reuse the built-in `get secret` completer so names and global flags behave
# exactly like the native command.
if [[ "${1:-}" == "__complete" ]]; then
  shift
  exec kubectl __complete get secret "$@"
fi

case "${1:-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
  "")
    usage
    exit 2
    ;;
esac

manifest_json="$({ kubectl get secret "$@" -o json; } | jq -e '
  if .kind != "Secret" then
    error("kubectl secret expects exactly one Secret name")
  else
    .
  end
  | .stringData = (
      (.data // {})
      | with_entries(
          .key as $key
          | .value as $encoded
          | ($encoded | @base64d) as $decoded
          | if ($decoded | @base64) == $encoded then
              .value = $decoded
            else
              error("Secret value for \($key) is binary, not UTF-8 text")
            end
        )
    )
  | del(
      .data,
      .metadata.creationTimestamp,
      .metadata.managedFields,
      .metadata.resourceVersion,
      .metadata.uid
    )
')"

if yq --help 2>&1 | grep -q -- '--yaml-output'; then
  printf '%s\n' "$manifest_json" | yq --yaml-output --width 0 '.'
elif yq --help 2>&1 | grep -q -- '--output-format'; then
  printf '%s\n' "$manifest_json" | yq eval --prettyPrint --output-format yaml '.' -
else
  printf 'yq is not installed; emitting JSON instead of YAML\n' >&2
  printf '%s\n' "$manifest_json"
fi

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.phil.cmux-remote-workspace-keeper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/phil/.local/bin/cmux-remote-workspace-keeper</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/Users/phil/Library/Logs/cmux-remote-workspace-keeper.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/phil/Library/Logs/cmux-remote-workspace-keeper.log</string>
</dict>
</plist>

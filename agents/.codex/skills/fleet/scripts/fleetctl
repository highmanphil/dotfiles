#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  fleetctl status [mac|home|vps|all]
  fleetctl exec <mac|home|vps> -- <command> [args...]
  fleetctl sync [mac|home|vps|all]
  fleetctl converge [mac|home|vps|all]
EOF
}

controller() {
  case "$(hostname -s 2>/dev/null || hostname)" in
    Philipps-MacBook-Air|philipps-macbook-air) printf 'mac\n' ;;
    phil-cachyos) printf 'home\n' ;;
    ubuntu) printf 'vps\n' ;;
    *)
      case "$(uname -s)" in
        Darwin) printf 'mac\n' ;;
        *) printf 'unknown\n' ;;
      esac
      ;;
  esac
}

endpoint() {
  case "$1" in
    mac) printf 'phil@100.123.207.72\n' ;;
    home) printf 'phil@100.104.47.26\n' ;;
    vps) printf 'root@217.160.186.7\n' ;;
    *) return 2 ;;
  esac
}

identity() {
  case "$(controller):$1" in
    mac:home|mac:vps) printf '%s/.ssh/id_rsa\n' "$HOME" ;;
    home:mac|home:vps) printf '%s/.ssh/id_gmx\n' "$HOME" ;;
    *) return 2 ;;
  esac
}

run_on() {
  local target="$1"
  shift
  if [[ "$target" == "$(controller)" ]]; then
    "$@"
    return
  fi
  if [[ "$(controller)" == vps || "$(controller)" == unknown ]]; then
    printf 'This host is not configured as a fleet controller.\n' >&2
    return 2
  fi
  local key
  key="$(identity "$target")"
  [[ -f "$key" ]] || { printf 'Missing fleet identity: %s\n' "$key" >&2; return 2; }
  local remote_command='' quoted argument
  for argument in "$@"; do
    printf -v quoted '%q' "$argument"
    remote_command="${remote_command}${quoted} "
  done
  ssh -o BatchMode=yes -o ConnectTimeout=8 -o IdentitiesOnly=yes -i "$key" "$(endpoint "$target")" "$remote_command"
}

status_one() {
  local target="$1"
  printf '\n== %s ==\n' "$target"
  run_on "$target" sh -lc '
    printf "host=%s user=%s os=%s\n" "$(hostname)" "$(id -un)" "$(uname -s)"
    if [ -d "$HOME/dotfiles/.git" ]; then
      git -C "$HOME/dotfiles" status --short --branch
    else
      printf "dotfiles=missing\n"
    fi
    for item in "$HOME/.codex/AGENTS.md" "$HOME/.codex/skills/fleet"; do
      if [ -L "$item" ]; then
        printf "%s -> %s\n" "$item" "$(readlink "$item")"
      elif [ -e "$item" ]; then
        printf "%s (not a symlink)\n" "$item"
      else
        printf "%s (missing)\n" "$item"
      fi
    done
    skill_store="$HOME/.local/share/fleet-skills"
    if [ -d "$skill_store/.git" ]; then
      if [ -n "$(git -C "$skill_store" status --porcelain)" ]; then
        skill_state=dirty
      elif git -C "$skill_store" fetch --quiet origin main; then
        skill_local="$(git -C "$skill_store" rev-parse HEAD)"
        skill_origin="$(git -C "$skill_store" rev-parse origin/main)"
        if [ "$skill_local" = "$skill_origin" ]; then
          skill_state=current
        elif git -C "$skill_store" merge-base --is-ancestor "$skill_local" "$skill_origin"; then
          skill_state=pending
        elif git -C "$skill_store" merge-base --is-ancestor "$skill_origin" "$skill_local"; then
          skill_state=ahead
        else
          skill_state=diverged
        fi
        printf "skills=%s local=%s desired=%s\n" "$skill_state" "$(git -C "$skill_store" rev-parse --short "$skill_local")" "$(git -C "$skill_store" rev-parse --short "$skill_origin")"
      else
        printf "skills=fetch-error local=%s desired=unknown\n" "$(git -C "$skill_store" rev-parse --short HEAD)"
      fi
      [ "${skill_state:-}" = dirty ] && printf "skills=dirty local=%s desired=unknown\n" "$(git -C "$skill_store" rev-parse --short HEAD)"
    else
      printf "skills=unmanaged\n"
    fi
    if [ -f "$HOME/.local/state/fleet/last-success" ]; then
      printf "last_converged=%s\n" "$(sed -n "1p" "$HOME/.local/state/fleet/last-success")"
    else
      printf "last_converged=never\n"
    fi
    if [ -f "$HOME/.local/state/fleet/last-error" ]; then
      printf "last_error=%s\n" "$(sed -n "1p" "$HOME/.local/state/fleet/last-error")"
    fi
  '
}

sync_one() {
  local target="$1"
  printf '\n== syncing %s ==\n' "$target"
  run_on "$target" sh -lc 'exec "$HOME/dotfiles/scripts/fleet-converge.sh"'
}

run_for_targets() {
  local operation="$1" target="$2" host failed=0
  if [[ "$target" == all ]]; then
    for host in mac home vps; do
      if ! "$operation" "$host"; then
        printf '%s is unavailable or failed; it remains pending.\n' "$host" >&2
        failed=1
      fi
    done
    return "$failed"
  fi
  "$operation" "$target"
}

command_name="${1:-}"
case "$command_name" in
  status)
    target="${2:-all}"
    run_for_targets status_one "$target"
    ;;
  exec)
    target="${2:-}"
    [[ -n "$target" ]] || { usage >&2; exit 2; }
    shift 2
    [[ "${1:-}" == -- ]] && shift
    [[ "$#" -gt 0 ]] || { usage >&2; exit 2; }
    run_on "$target" "$@"
    ;;
  sync)
    target="${2:-all}"
    run_for_targets sync_one "$target"
    ;;
  converge)
    target="${2:-all}"
    run_for_targets sync_one "$target"
    ;;
  *) usage >&2; exit 2 ;;
esac
